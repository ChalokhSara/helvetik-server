# Variables lues par docker compose en production.
#
#   cp .env.example .env
#   # puis renseigner les valeurs
#   docker compose up -d --build
#
# En développement, rien de tout cela n'est nécessaire :
# COMPOSE_PROFILES=DEV suffit, et les emails partent dans Mailpit.
#
# Ce fichier est un modèle : le `.env` réel ne doit jamais être versionné.

# --- choix de l'environnement ----------------------------------------------

# Le seul réglage à changer pour basculer d'un environnement à l'autre.
# Tout le reste — services, images, ports — vit dans docker-compose.yml.
#
#   DEV    développement : emails capturés par Mailpit, secrets de test,
#          aucune autre variable nécessaire.
#   PROD   production    : emails réellement expédiés, et les variables
#          obligatoires ci-dessous doivent être renseignées.
#
# Dans les deux cas, la commande est la même :
#   docker compose up -d --build
COMPOSE_PROFILES=DEV

# --- obligatoire en production (COMPOSE_PROFILES=PROD) ---------------------
#
# L'application contrôle ces valeurs elle-même au démarrage : sans elles, elle
# s'arrête plutôt que de tourner à moitié configurée.

# Secret de signature des cookies de session. À générer une fois :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Clé de chiffrement des pièces d'identité (cartes d'identité, passeports)
# conservées pour être jointes aux lettres de résiliation et d'affiliation.
# 32 octets, en base64. À générer une fois :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# À conserver hors de la base : c'est précisément ce qui fait qu'une
# sauvegarde MongoDB volée ne livre pas les pièces d'identité.
# La perdre rend toutes les pièces déjà déposées illisibles — elles devront
# être redéposées. La changer a le même effet.
DOCUMENT_ENCRYPTION_KEY=

# --- lecture des polices d'assurance ---------------------------------------

# Les polices déposées passent par une reconnaissance optique, puis par un
# modèle de langage qui en tire la caisse, le modèle, la franchise et la prime.
#
# Ce modèle tourne dans le conteneur `ollama`, sur le réseau Docker interne :
# il n'a **aucun port publié**, et le contenu des polices — nom, adresse,
# n° AVS, n° de police — ne sort jamais de la machine.
#
# Prévoir environ 4 Go de mémoire vive pour le modèle par défaut. Sur une
# petite machine, deux solutions : un modèle plus léger (llama3.2:1b), ou
# OLLAMA_ENABLED=false, qui rabat la lecture sur les motifs textuels — la
# saisie manuelle reste de toute façon possible.
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_ENABLED=true
# OLLAMA_TIMEOUT_MS=90000

# --- envoi des courriers par ePost -----------------------------------------

# Le service poste les lettres de résiliation et d'affiliation via l'API
# oneAPI de la Poste. Deux réglages seulement décident de ce qui part.
#
#   EPOST_MODE=PREVIEW  interroge l'API sans rien poster : elle renvoie les
#                       canaux disponibles et le prix. Tout est exercé, rien
#                       n'est envoyé ni facturé. C'est le défaut.
#   EPOST_MODE=LIVE     poste réellement, en recommandé.
#
# EPOST_ENABLED=false laisse l'assuré télécharger ses lettres comme avant.
# EPOST_ENABLED=true
# EPOST_MODE=PREVIEW

# Identifiants du compte ePost : ceux du portail, rien à générer. Seuls ces
# deux-là sont indispensables.
EPOST_USERNAME=
EPOST_PASSWORD=

# Clé d'API. Facultative : l'authentification a été vérifiée contre
# api.epost.ch sans clé, et une clé fantaisiste n'y change rien. Elle est
# transmise quand elle est renseignée, au cas où un compte l'exigerait.
EPOST_API_KEY=

# Tenant et company sont découverts au premier appel et affichés dans les
# logs — les y figer ensuite évite un aller-retour et une exposition du mot
# de passe à chaque renouvellement de jeton.
EPOST_TENANT_ID=
EPOST_COMPANY_ID=

# Affranchissement. REGISTERED (recommandé) est le seul valable pour une
# résiliation LAMal : c'est la date de réception qui fait foi, et seul le
# recommandé en apporte la preuve.
# EPOST_POSTAGE=REGISTERED

# Adresse publique du service, telle que les utilisateurs y accèdent.
# Elle apparaît dans les liens de confirmation envoyés par email.
APP_BASE_URL=https://helvetik.example.ch

# Domaine depuis lequel les emails sont expédiés. Obligatoire : le relais
# Postfix intégré n'accepte d'envoyer que pour ce domaine.
MAIL_DOMAIN=helvetik.example.ch

# Nom annoncé aux serveurs distants. Idéalement identique à l'enregistrement
# PTR (DNS inverse) de l'IP du serveur, sinon beaucoup de destinataires
# refuseront les messages.
# MAIL_HOSTNAME=mail.helvetik.example.ch

# --- envoi des emails ------------------------------------------------------
#
# Par défaut, le relais Postfix embarqué (service `mailer`) expédie lui-même.
# Rien à configurer, mais une partie des messages finira en indésirables.
#
# Pour utiliser un relais externe à la place — nettement meilleure
# délivrabilité — renseigner les quatre lignes ci-dessous. Exemples :
#   Hostinger : smtp.hostinger.com, port 465, SMTP_SECURE=true
#   Brevo     : smtp-relay.brevo.com, port 587, SMTP_SECURE=false
# SMTP_HOST=
# SMTP_PORT=587
# true pour une connexion TLS directe (port 465), false pour STARTTLS (587)
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Indispensable avec un relais externe : sans cela les identifiants
# circuleraient en clair.
# SMTP_IGNORE_TLS=false

# Confirmation d'email avant connexion — valeur INITIALE seulement.
# Le réglage se pilote ensuite depuis la console : Réglages → Confirmation
# d'adresse email. Dès qu'un administrateur y enregistre un choix, c'est lui
# qui s'applique, et cette variable n'a plus d'effet : un redéploiement ne
# vient donc pas écraser sa décision.
EMAIL_CONFIRMATION_REQUIRED=false

# --- facultatif ------------------------------------------------------------

# Expéditeur affiché. Le domaine doit être autorisé chez le relais SMTP,
# sinon les messages partiront en indésirables ou seront rejetés.
MAIL_FROM=Helvetik <no-reply@helvetik.example.ch>

# Port exposé sur la machine hôte.
API_PORT=3000

# Reverse proxy : 1 = un seul proxy devant l'application.
TRUST_PROXY=1

# Hôtes acceptés dans les liens si APP_BASE_URL venait à manquer.
# APP_ALLOWED_HOSTS=helvetik.example.ch,www.helvetik.example.ch

# Adresse du compte administrateur créé au premier démarrage.
ROOT_ADMIN_EMAIL=root@helvetik.example.ch

# Tâches de fond.
TZ=Europe/Zurich
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_CRON=0 8 * * *
PREMIUM_SYNC_ENABLED=true
PREMIUM_SYNC_CRON=0 4 1 * *
OCR_LANGUAGES=fra+deu
