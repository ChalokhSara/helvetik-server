NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://mongodb:27017/insurance-app
SESSION_SECRET=dev-only-secret
ROOT_ADMIN_EMAIL=root@helvetik.local
# Base des liens envoyés par email (confirmation de compte)
APP_BASE_URL=http://localhost:3000

# SMTP — Mailpit (docker-compose). Hors conteneur, le port 1025 est publié
# sur la machine hôte. Sans SMTP_HOST, les emails partent dans les logs.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Helvetik <no-reply@helvetik.local>
# Relais réel uniquement : laisser vide avec Mailpit
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Notifications d'échéance (rappels de résiliation à 90, 30 et 7 jours)
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_CRON=0 8 * * *
# Déclenche une passe au démarrage, pratique en développement
NOTIFICATIONS_RUN_ON_START=false
TZ=Europe/Zurich

# Comparateur officiel de l'OFSP (liens préremplis)
PRIMINFO_BASE_URL=https://www.priminfo.admin.ch

# Récupération automatique des fichiers de primes de l'OFSP.
# Import en état « préparée » : la mise en service reste manuelle.
PREMIUM_SYNC_ENABLED=true
PREMIUM_SYNC_CRON=0 4 1 * *

# Reconnaissance de texte sur les documents deposes par les assures.
# Les donnees de langue sont telechargees au premier usage puis mises en cache.
OCR_LANGUAGES=fra+deu
TESSERACT_CACHE_PATH=/app/.tessdata
